# git-workflow: general-purpose aliases, unrelated to the flow.
#
# `git workflow aliases install` copied this file to
# ~/.config/git-workflow/aliases/extras and included it from ~/.gitconfig.
# This copy is yours to edit. `git workflow aliases reset extras` restores
# the default.
[alias]
    lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
    graph = log --graph --oneline --all --decorate --color
    aa = add .
    au = add -u
    s = status -sb
    st = status
    fprune = fetch --all --prune
