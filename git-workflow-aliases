[alias]
    lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all

    graph = log --graph --oneline --all --decorate --color

    aa = add .

    au = add -u

    s = status -sb

    st = status

    b = branch

    sq = "!f() { name=\"${1:-next}\" && git rebase -i \"$name\"; }; f"

    ps = "!f() { \
        current=\"$(git branch --show-current)\"; \
        if [ \"$current\" = \"main\" ] || [ \"$current\" = \"next\" ]; then \
            read -r -p \"On $current. Are you sure you want to push? [y/N] : \" confirm; \
            case \"$confirm\" in \
                [yY][eE][sS]|[yY]) \
                    : \
                    ;; \
                *) \
                    echo \"Aborted.\"; \
                    return 1; \
                    ;; \
            esac; \
        fi; \
        if git ls-remote --exit-code --heads origin \"$current\" > /dev/null 2>&1; then \
            echo \"Branch exists on remote. Syncing...\"; \
            git fetch origin \"$current\"; \
            git stash -u; \
            git pull --rebase origin \"$current\"; \
            git stash pop; \
        else \
            echo \"Branch does not exist on remote yet. Pushing anyway.\"; \
        fi; \
        git push -u origin \"$current\"; \
    }; f"

    forceUp = "!f() { \
        choice=\"${1:-$(git branch --show-current)}\"; \
        if [ \"$choice\" = \"main\" ] || [ \"$choice\" = \"next\" ]; then \
            read -r -p \"Are you sure you want to push $choice? [y/N] : \" confirm; \
            case \"$confirm\" in \
                [yY][eE][sS]|[yY]) \
                    : \
                    ;; \
                *) \
                    echo \"Aborted.\"; \
                    return 1; \
                    ;; \
            esac; \
        fi; \
        push --force-with-lease origin \"$choice\"; \
    }; f"
    
    sync = "!f() { \
        git fetch --all --prune; \
        current=\"${1:-$(git branch --show-current)}\"; \
        git switch \"$current\"; \
        git stash -u; \
        git pull --rebase origin \"$current\"; \
        git stash pop; \
    }; f"

    c = "!f() { \
        message=\"$1\"; \
        if [ -z \"$message\" ]; then \
            read -r -p \"Enter a commit message: \" message; \
        fi; \
        if [ -z \"$message\" ]; then \
            echo \"No message provided. Aborted.\"; return 1; \
        fi; \
        git commit -m \"$message\"; \
    }; f";

    qc = "!f() { \
        message=\"$1\"; \
        current=\"$(git branch --show-current)\"; \
        if [ \"$current\" = \"main\" ] || [ \"$current\" = \"next\" ]; then \
            read -r -p \"On $current. Are you sure you want to commit? [y/N] : \" confirm; \
            case \"$confirm\" in \
                [yY][eE][sS]|[yY]) \
                    : \
                    ;; \
                *) \
                    echo \"Aborted.\"; \
                    return 1; \
                    ;; \
            esac; \
        fi; \
        if [ -z \"$message\" ]; then \
            read -r -p \"Enter a commit message: \" message; \
        fi; \
        if [ -z \"$message\" ]; then \
            echo \"No message provided. Aborted.\"; return 1; \
        fi; \
        if git ls-remote --exit-code --heads origin \"$current\" > /dev/null 2>&1; then \
            echo \"Branch exists on remote. Syncing...\"; \
            git fetch origin \"$current\"; \
            git stash -u; \
            git pull --rebase origin \"$current\"; \
            git stash pop; \
        else \
            echo \"Branch does not exist on remote yet. Skipping pull.\"; \
        fi; \
        git add -u && git commit -m \"$message\"; \
    }; f"

    qcp = "!f() { \
        message=\"$1\"; \
        git qc \"$message\"; \
        git push -u origin \"$current\"; \
    }; f"

    deleteBranch = "!f() { \
        choice=\"${1:-$(git branch --show-current)}\"; \
        force=\"${2:-}\"; \
        switched=0; \
        if [ -z \"$choice\" ] || [ \"$choice\" = \"main\" ] || [ \"$choice\" = \"next\" ]; then \
            echo \"Error: no branch specified, or protected branch $choice\"; \
            return 1; \
        fi; \
        if [ -n \"$(git ls-files --others --exclude-standard)\" ]; then \
            echo \"ERROR: You have untracked files. Please add or delete them.\"; \
            return 1; \
        fi; \
        current=$(git branch --show-current); \
        if [ \"$choice\" = \"$current\" ]; then \
            git switch next || { echo \"Failed to switch to next (does it exist?)\"; return 1; }; \
            echo \"Switched to 'next' to allow deletion of $choice.\"; \
            switched=1; \
        fi; \
        case \"$force\" in \
            yes|-y|--yes|--y|y|d|-d|--d|--delete) \
                confirm=\"y\"; \
                ;; \
            *) \
                read -p \"Delete \"$choice\" locally and remotely? [y/N] \" confirm; \
                ;; \
        esac; \
        case \"$confirm\" in \
            [yY][eE][sS]|[yY]) \
                git branch -d \"$choice\" && \
                git push origin --delete \"$choice\" || echo \"Remote delete failed (maybe already gone)\"; \
                echo \"Branch $choice deleted locally and remotely.\"; \
                ;; \
            *) \
                echo \"Aborted.\"; \
                if [ \"$switched\" -eq 1 ]; then \
                    git switch \"$current\"; \
                    echo \"Switched back to $current\"; \
                fi; \
                return 1; \
                ;; \
        esac; \
    }; f"


    finish = "!f() { \
        currentBranch=$(git branch --show-current); \
        if [ \"$currentBranch\" = \"main\" ] || [ \"$currentBranch\" = \"next\" ]; then \
            echo \"ERROR: You cannot 'finish' the $currentBranch branch.\"; return 1; \
        fi; \
        if [ -n \"$(git ls-files --others --exclude-standard)\" ]; then \
            echo \"ERROR: You have untracked files. Please add or delete them.\"; \
            return 1; \
        fi; \
        case \"$currentBranch\" in \
            release/*|hotfix/*) \
                type=\"${currentBranch%/*}\"; \
                versionTag=\"${currentBranch#*/}\"; \
                echo \"Fix conflicts by rebasing or remerging first.\"; \
                read -p \"Merge '$currentBranch' into main and next, push changes and tag? [y/N] \" confirm; \
                case \"$confirm\" in [yY][eE][sS]|[yY]) : ;; *) echo \"Aborted.\"; return 1; ;; esac; \
                git switch main && \
                git pull --rebase && \
                git merge --no-ff \"$currentBranch\" && \
                git tag -a \"$versionTag\" -m \"$type: $versionTag\" && \
                git switch next && \
                git merge --ff-only main && \
                git push origin main next --tags && \
                echo \"RUN: git deleteBranch $currentBranch yes\"; \
                ;; \
            *) \
                echo \"Fix conflicts by rebasing or remerging first.\"; \
                read -p \"Merge '$currentBranch' into next, and push changes? [y/N] \" confirm; \
                case \"$confirm\" in [yY][eE][sS]|[yY]) : ;; *) echo \"Aborted.\"; return 1; ;; esac; \
                git switch next && \
                git merge --no-ff \"$currentBranch\" && \
                git push origin next && \
                echo \"RUN: git deleteBranch $currentBranch yes\"; \
                ;; \
        esac; \
    }; f"

    start = "!f() { \
        git rev-parse --verify next || { echo \"Could not find 'next' branch.\"; return 1; }; \
        mode=\"$1\"; \
        if [ -z \"$mode\" ]; then \
            echo \"ERROR: usage: git start topic <branch-name>    Start a topic branch\"; \
            echo \"       usage: git start -r <version-tag>       Start a release\"; \
            return 1; \
        fi; \
        if [ -n \"$(git ls-files --others --exclude-standard)\" ]; then \
            echo \"ERROR: You have untracked files I can't autostash. Please add or delete them.\"; \
            return 1; \
        fi; \
        case \"$mode\" in \
            topic|t|-t|--topic) \
                branchName=\"$2\"; \
                if [ -z \"$branchName\" ]; then \
                    read -r -p \"Enter new topic branch name: \" branchName; \
                fi; \
                if [ -z \"$branchName\" ]; then \
                    echo \"No branch name provided. Exiting.\"; return 1; \
                fi; \
                git fetch --all --prune; \
                git switch next && \
                git pull --rebase --autostash; \
                git switch -c \"$branchName\" next; \
                git push -u origin \"$branchName\"; \
                ;; \
            hotfix|h|-h|--hotfix) \
                fixName=\"$2\"; \
                if [ -z \"$fixName\" ]; then \
                    read -r -p \"Enter hotfix branch name: \" fixName; \
                fi; \
                if [ -z \"$fixName\" ]; then \
                    echo \"No name provided. Aborted.\"; return 1; \
                fi; \
                git fetch --all --prune; \
                git switch main && \
                git pull --rebase --autostash; \
                git switch -c \"hotfix/$fixName\" main; \
                git push -u origin \"hotfix/$fixName\"; \
                ;; \
            release|r|-r|--release) \
                version=\"$2\"; \
                if [ -z \"$version\" ]; then \
                    read -r -p \"Enter version tag (e.g. v1.2.3): \" version; \
                fi; \
                if [ -z \"$version\" ]; then \
                    echo \"No version provided. Aborted.\"; return 1; \
                fi; \
                git fetch --all --prune; \
                git switch next && \
                git pull --rebase --autostash; \
                git switch -c \"release/$version\" next; \
                git push -u origin \"release/$version\"; \
                ;; \
            *) \
                echo \"ERROR: unknown mode: $mode\"; return 1; \
                ;; \
        esac; \
    }; f"