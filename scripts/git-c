#!/bin/bash

set -euo pipefail

## Where the scripts live
# GIT_SCRIPTS_HOME_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
script_path=$(
    CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P
)/$(basename -- "$0")
GIT_SCRIPTS_HOME_DIR=$(dirname "$script_path")

# Source util script
. "$GIT_SCRIPTS_HOME_DIR/scripts/git-core-utils.sh"

normal_commit() {
    commit_message_check
    git commit -m "$__RETURN_VAL"
}