set -eu
[ "$#" -eq 0 ] && exec git --no-pager branch

# Find script dir
if [ -z "${GIT_SCRIPTS_HOME_DIR:-}" ]; then
    GIT_SCRIPTS_HOME_DIR=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
    export GIT_SCRIPTS_HOME_DIR
fi
# Source util script
. "$GIT_SCRIPTS_HOME_DIR/lib/git-core-utils.sh"
. "$GIT_SCRIPTS_HOME_DIR/lib/git-release-utils.sh"
. "$GIT_SCRIPTS_HOME_DIR/lib/git-branch-utils.sh"

b_usage() {
    cat >&2 <<EOF
usage: git b [<subcommand>] [args]

  start <topic|release|hotfix> [name]   start a branch (release/hotfix name = vX.Y.Z)
  prerelease|pre [label|tag] [-n] [-l]  tag the release branch as vX.Y.Z-<label>.N and push
  finish [branch]                       merge per the flow, tag releases/hotfixes, push
  delete [branch] [-y]                  delete a branch locally and on the remote
  config                                show the effective workflow settings
  help                                  this message

Anything else is passed to 'git branch' (e.g. 'git b -a', 'git b -vv').
EOF
}

B_SUBCMD="${1:-}"
shift

case "$B_SUBCMD" in
start)
    start_branch "$@"
    ;;
finish)
    finish_branch "$@"
    ;;
delete)
    delete_branch "$@"
    ;;
prerelease | pre)
    prerelease_branch "$@"
    ;;
config)
    show_config
    ;;
help | --help | -h)
    b_usage
    ;;
*)
    exec git branch "$B_SUBCMD" "$@"
    ;;
esac
