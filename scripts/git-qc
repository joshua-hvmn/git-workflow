#!/bin/bash

set -eu

# Find script dir
if [ -z "${GIT_SCRIPTS_HOME_DIR:-}" ]; then
    script_path=${BASH_SOURCE[0]}
    case $script_path in
        */*) script_dir=${script_path%/*} ;;
        *) script_dir=. ;;
    esac
    
    GIT_SCRIPTS_HOME_DIR=$(cd "$script_dir" && pwd)
    export GIT_SCRIPTS_HOME_DIR
fi
# Source util script
. "$GIT_SCRIPTS_HOME_DIR/git-core-utils.sh"

QC_MODE="${1:-}"
case "$QC_MODE" in
    p)
        shift
        ;;
    -p|push)
        QC_MODE="p"
        shift
        ;;
    *)
        QC_MODE=""
        ;;
esac

working_branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"

case "$working_branch" in
    main|master|next)
        if yes_no "On $working_branch, are you sure you want to commit?"; then
            :
        else
            printf "\nAborted\n" >&2
            exit 1
        fi
        ;;
esac

if git ls-remote --exit-code --heads origin "$working_branch" > /dev/null 2>&1; then
    printf "\nBranch exists on remote. Syncing...\n" >&2
#    git fetch origin "$working_branch"
    "$GIT_SCRIPTS_HOME_DIR/git-rb-pull" "$working_branch"
fi

"$GIT_SCRIPTS_HOME_DIR/git-c" "$@"

if [ "$QC_MODE" = "p" ]; then
    git push -u origin "$working_branch"
fi